{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["cli.ts", "run.ts", "config/**/*.ts", "helpers/**/*.ts", "types/**/*.d.ts", "types.ts", "pages/**/*.ts", "tests/**/*.ts", "core/**/*.ts", "workflows/**/*.ts"]
}
